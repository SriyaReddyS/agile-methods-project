# Wildlife Guardian chatbot configuration.
# Copy to .env (never commit .env) and fill in real values locally.
# Keys are used server-side only and never sent to browsers.

# Set ONE provider key. If both are set, OpenAI is used unless CHATBOT_PROVIDER says otherwise.
# OpenAI key: https://platform.openai.com/api-keys (OPEN_AI_API_KEY is also accepted)
OPENAI_API_KEY=your-openai-api-key-here
# Anthropic key: https://platform.claude.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: force a provider (openai or anthropic).
# CHATBOT_PROVIDER=openai

# live = call the AI provider (needs a key above)
# mock = deterministic demo answers built from animal-data.js, no API calls
CHATBOT_MODE=live

# Optional model overrides.
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# Port for the local server.
PORT=8000
