# Wildlife Guardian chatbot configuration.
# Copy to .env (never commit .env) and fill in real values locally.

# Anthropic Claude API key, server-side only. Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# live = call the Claude API (needs ANTHROPIC_API_KEY)
# mock = deterministic demo answers built from animal-data.js, no API calls
CHATBOT_MODE=live

# Claude model used for answers.
CHATBOT_MODEL=claude-sonnet-5-5

# Port for the local server.
PORT=8000
